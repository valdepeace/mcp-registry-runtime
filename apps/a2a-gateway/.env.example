NODE_ENV=development
PORT=4271

# Where the actual catalog and runtime live.
REGISTRY_URL=http://localhost:4269
RUNTIME_URL=http://localhost:4270

# Must match apps/runtime's JWT_SECRET — the dashboard's admin login token
# is reused here for key management, and this gateway mints its own
# short-lived service tokens toward runtime with the same secret.
JWT_SECRET=your-super-secret-jwt-key-change-me

# Public URL other agents reach this gateway at, advertised in the Agent Card.
PUBLIC_URL=http://localhost:4271

CORS_ORIGINS=*

# Defaults to <workspace-root>/mcp-registry-runtime-data/a2a-gateway.db.
# Uncomment to override.
# DB_PATH=./data/a2a-gateway.db
