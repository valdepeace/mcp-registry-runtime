NODE_ENV=development
PORT=3001
# Where the SQLite DB lives. Defaults to
# <workspace-root>/mcp-registry-runtime-data/runtime.db, where workspace-root
# is the parent folder of this cloned repo (same place no matter where the
# process is launched from). Uncomment to override.
# DB_PATH=./data/runtime.db
JWT_SECRET=change-me-in-production
CORS_ORIGINS=*
REGISTRY_URL=http://localhost:3000
REPOS_DIR=./data/repos
