# Environment
NODE_ENV=development
PORT=3000

# Official MCP Registry (servers)
OFFICIAL_REGISTRY_URL=https://registry.modelcontextprotocol.io
SYNC_INTERVAL_MS=300000
SYNC_ON_STARTUP=true

# External Skill Registries (optional — sync skills from hub APIs)
# Skills.sh: leaderboard of agent skills with full content via detail endpoint
# API key required — get one at https://skills.sh
SKILLS_SH_API_URL=https://skills.sh/api/v1
# SKILLS_SH_API_KEY=sk_live_...

# Smithery.ai: marketplace for MCP servers + skills
SMITHERY_API_URL=https://api.smithery.ai

# Legacy external registries (optional, for MCP-compatible APIs)
# OFFICIAL_SKILLS_REGISTRY_URL=
# OFFICIAL_AGENTS_REGISTRY_URL=

# Database
DB_PATH=./data/registry.db

# Auth (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS
CORS_ORIGINS=*
