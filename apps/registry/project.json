{
  "name": "registry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/registry",
  "sourceRoot": "apps/registry/src",
  "targets": {
    "dev": {
      "continuous": true,
      "command": "tsx watch src/index.ts",
      "options": { "cwd": "{projectRoot}" }
    },
    "debug": {
      "continuous": true,
      "command": "node --inspect=0.0.0.0:9229 --import=tsx/esm --watch src/index.ts",
      "options": { "cwd": "{projectRoot}" }
    },
    "build": {
      "command": "tsc",
      "options": { "cwd": "{projectRoot}" }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "start": {
      "command": "node dist/index.js",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["build"]
    }
  }
}
