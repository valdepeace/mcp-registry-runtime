    "svelte": "^5.34.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@mcp-nova/types": "*",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0"
