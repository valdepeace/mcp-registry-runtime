{
  "name": "mcp-registry-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Private MCP Server Registry - Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --parallel=4",
    "dev:registry": "nx run registry:dev",
    "dev:runtime": "nx run runtime:dev",
    "dev:frontend": "nx run frontend:dev",
    "debug": "nx run-many -t debug -p registry,runtime --parallel=2",
    "debug:registry": "nx run registry:debug",
    "debug:runtime": "nx run runtime:debug",
    "build": "nx run-many -t build --parallel=4",
    "build:registry": "nx run registry:build",
    "build:runtime": "nx run runtime:build",
    "build:frontend": "nx run frontend:build",
    "start": "nx run registry:start",
    "typecheck": "nx run-many -t typecheck --parallel=4"
  },
  "keywords": [
    "mcp",
    "registry",
    "model-context-protocol"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nx": "22.7.3"
  }
}